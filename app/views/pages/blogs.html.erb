<%# Orchha Blogs — 3-per-row story grid, same design language as News %>
<% ft       = (@home['footer'] || {})
   ft_links = ft['links'] || []
   nav      = @home['nav']   || {}
   dd       = nav['discoverDropdown'] || []
   vs       = @home['visit'] || {}
   items    = @items.presence || []
%>

<%# Sticky HOHO button %>
<div class="sticky-hoho">
  <a href="/hoho">HOHO Service</a>
</div>

<div class="news-p-page">

  <%# ── NAVBAR ─────────────────────────────────────────── %>
  <div class="mon-nav-wrap">
    <nav class="hist-navbar">
      <div class="nav-links">
        <div class="nav-discover">
          <a href="/" class="hist-nav-link hist-nav-discover-btn" aria-expanded="false" aria-haspopup="true">
            Discover Orchha
            <svg viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
        <a href="/plan-your-visit" class="hist-nav-link">Plan Your Visit</a>
        <a href="/news" class="hist-nav-link nav-resources-btn" aria-haspopup="true" aria-expanded="false">Resources <svg viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        <a href="https://pages.razorpay.com/pl_PWE9fVFc9oLCel/view" target="_blank" rel="noopener" class="hist-nav-link">Support Us</a>
        <a href="/sabhyata" class="hist-nav-link">Sabhyata Foundation</a>
      </div>
      <button class="hist-nav-hamburger" id="hist-nav-hamburger-btn" aria-label="Open menu" aria-expanded="false">
        <svg viewBox="0 0 24 24" fill="none"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </button>
      <a href="https://www.tezticket.com/tickets/buy?event=SF" target="_blank" rel="noopener" class="hist-book-btn">Book Tickets</a>
    </nav>

    <div class="hist-nav-mobile-menu" id="hist-nav-mobile-menu">
      <button class="hist-nav-mobile-close" id="hist-nav-mobile-close-btn" aria-label="Close menu">
        <svg viewBox="0 0 24 24" fill="none"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </button>
      <a href="/" class="nav-mobile-wordmark" aria-label="Home">ORCHHA</a>
      <div class="hist-nav-mobile-links">
        <div class="nav-mobile-group">
          <button type="button" class="hist-nav-mobile-link nav-mobile-group-btn" aria-expanded="false">
            Discover Orchha
            <svg viewBox="0 0 10 6" fill="none"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="nav-mobile-group-items">
            <% dd.each do |item| %>
            <a href="<%= item['url'] %>" class="hist-nav-mobile-link nav-mobile-sub-link"><%= item['label'] %></a>
            <% end %>
          </div>
        </div>
        <a href="/plan-your-visit" class="hist-nav-mobile-link">Plan Your Visit</a>
        <a href="/news" class="hist-nav-mobile-link">News</a>
        <a href="/blogs" class="hist-nav-mobile-link">Blogs</a>
        <a href="https://pages.razorpay.com/pl_PWE9fVFc9oLCel/view" target="_blank" rel="noopener" class="hist-nav-mobile-link">Support Us</a>
        <a href="/sabhyata" class="hist-nav-mobile-link">Sabhyata Foundation</a>
      </div>
      <div class="nav-mobile-cta-row">
        <a href="https://www.tezticket.com/tickets/buy?event=SF" target="_blank" rel="noopener" class="hist-nav-mobile-book-btn">Book Tickets</a>
        <a href="/hoho" class="hist-nav-mobile-book-btn nav-mobile-hoho-btn">HOHO Service</a>
      </div>
    </div>

    <%# Discover dropdown — kept outside .hist-navbar because its backdrop-filter
        creates a new containing block for position:fixed descendants %>
    <div class="hist-nav-dropdown" role="menu">
      <% dd.each do |item| %>
      <a href="<%= item['url'] %>" class="hist-nav-dropdown-item" role="menuitem"><%= item['label'] %></a>
      <% end %>
    </div>
  </div>

  <%# ── HEADER ─────────────────────────────────────────── %>
  <header class="news-p-header">
    <h1 class="news-p-heading"><%= @page['heading'] || 'Orchha Blogs' %></h1>
    <p class="news-p-subheading"><%= @page['subheading'] || 'Long reads, travel notes and stories from the people who know Orchha best.' %></p>
  </header>

  <%# ── BLOG GRID (3 per row) ─────────────────────────── %>
  <section class="news-p-section">
    <div class="news-p-grid">
      <% items.each do |b| %>
      <a href="<%= b['link'].presence || '#' %>" class="news-p-card"
         data-pop-title="<%= b['heading'] %>" data-pop-tag="<%= b['author'].presence || 'Blog' %>" data-pop-date="<%= b['date'] %>"
         data-pop-img="<%= b['image'] %>" data-pop-text="<%= b['text'] %>" data-pop-link="<%= b['link'] %>">
        <div class="news-p-photo">
          <img src="<%= b['image'] %>" alt="<%= b['heading'] %>" loading="lazy">
        </div>
        <div class="news-p-body">
          <div class="news-p-meta">
            <span class="news-p-cat"><%= b['author'].presence || 'Blog' %></span>
            <span class="news-p-dot">&bull;</span>
            <span class="news-p-date"><%= b['date'] %></span>
          </div>
          <h3 class="news-p-title"><%= b['heading'] %></h3>
          <p class="news-p-text"><%= b['text'] %></p>
        </div>
        <span class="news-p-readmore">
          Read more
          <svg viewBox="0 0 5 9" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M1 1l3 3.5L1 8" stroke="#6e1603" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
      </a>
      <% end %>
      <% if items.empty? %>
      <p class="news-p-empty" style="display:block;">No blog posts yet — add some from the CMS.</p>
      <% end %>
    </div>
  </section>

  <%# ── VISIT ORCHHA (reused) ──────────────────────────── %>
  <div class="visit-wrap">
    <div class="visit-section">
      <div class="visit-bg-img" style="background-image: url('<%= vs['bgImage'] || '/images/visit_orchha_bg.jpg' %>')"></div>
      <div class="visit-content">
        <h2 class="visit-heading"><em>Visit</em> Orchha</h2>
        <div class="visit-links">
          <% (vs['links'] || [{'label'=>'How to Reach Orchha','url'=>'/visit-orchha'},{'label'=>'Travel Options','url'=>'/visit-orchha'},{'label'=>'Stay Options','url'=>'/accommodation'}]).each do |lnk| %>
          <a href="<%= lnk['url'] %>" class="visit-link"><%= lnk['label'] %></a>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <%# ── FOOTER ─────────────────────────────────────────── %>
<%= render 'shared/footer', ft: ft %>

</div><%# /.news-p-page %>

<%= render 'shared/news_popup' %>

<script>
  // ── Navbar dropdown ───────────────────────────────────────
  const blgBtn = document.querySelector('.hist-nav-discover-btn');
  const blgDd  = document.querySelector('.hist-nav-dropdown');
  if (blgBtn && blgDd) {
    let blgCloseTimer;
    function openBlgDd() {
      clearTimeout(blgCloseTimer);
      const r = blgBtn.getBoundingClientRect();
      blgDd.style.top  = (r.bottom + 8) + 'px';
      blgDd.style.left = r.left + 'px';
      blgDd.classList.add('open');
      blgBtn.classList.add('open');
      blgBtn.setAttribute('aria-expanded', 'true');
    }
    function closeBlgDd() {
      blgDd.classList.remove('open');
      blgBtn.classList.remove('open');
      blgBtn.setAttribute('aria-expanded', 'false');
    }
    function scheduleCloseBlgDd() { blgCloseTimer = setTimeout(closeBlgDd, 200); }
    blgBtn.addEventListener('mouseenter', openBlgDd);
    blgBtn.addEventListener('mouseleave', scheduleCloseBlgDd);
    blgDd.addEventListener('mouseenter', () => clearTimeout(blgCloseTimer));
    blgDd.addEventListener('mouseleave', scheduleCloseBlgDd);
    blgBtn.addEventListener('click', e => { if (blgDd.classList.contains('open')) return; e.preventDefault(); openBlgDd(); });
    document.addEventListener('click', closeBlgDd);
    blgDd.addEventListener('click', e => e.stopPropagation());
  }

  // ── Mobile hamburger menu ───────────────────────────────────
  const blgHamburgerBtn = document.getElementById('hist-nav-hamburger-btn');
  const blgMobileMenu   = document.getElementById('hist-nav-mobile-menu');
  const blgMobileClose  = document.getElementById('hist-nav-mobile-close-btn');
  if (blgHamburgerBtn && blgMobileMenu) {
    function openBlgMobileMenu() {
      blgMobileMenu.classList.add('open');
      blgHamburgerBtn.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }
    function closeBlgMobileMenu() {
      blgMobileMenu.classList.remove('open');
      blgHamburgerBtn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }
    blgHamburgerBtn.addEventListener('click', openBlgMobileMenu);
    if (blgMobileClose) blgMobileClose.addEventListener('click', closeBlgMobileMenu);
    blgMobileMenu.querySelectorAll('a').forEach(a => a.addEventListener('click', closeBlgMobileMenu));
  }
</script>
